#!/bin/sh
# zhiji-inbox: put a phone share (text on stdin, or --image) into the organizer inbox on this Spark.
# See organizer/inbox_cli.py and docs/PHONE.md. Uses the organizer's venv and data directory
# (ORGANIZER_VENV, ORGANIZER_DATA_DIR; the same defaults as ctl.sh).
HERE=$(cd "$(dirname "$0")" && pwd)
VENV=${ORGANIZER_VENV:-$HOME/hack/organizer-venv}
PY="$VENV/bin/python"
[ -x "$PY" ] || PY=python3
export ORGANIZER_DATA_DIR="${ORGANIZER_DATA_DIR:-$HOME/hack/organizer-data}"
cd "$HERE" && exec "$PY" -m organizer.inbox_cli "$@"
