{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestasr.local/schemas/evidence/process-tap-tcc-denial.schema.json",
  "title": "bestASR Process Tap actual TCC denial evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "spikeID",
    "runID",
    "generatedAt",
    "osVersion",
    "hardwareArchitecture",
    "probeBundleIdentifier",
    "status",
    "denialObserved",
    "operatorConfirmedDenial",
    "tapCreated",
    "createTapStatus",
    "captureStarted",
    "startCaptureStatus",
    "callbackCount",
    "frameCount",
    "capturedRMS",
    "capturedWatermarkAmplitude",
    "watermarkDetected",
    "audioContentSuppressed",
    "tapCountBefore",
    "tapCountAfter",
    "aggregateDeviceCountBefore",
    "aggregateDeviceCountAfter",
    "syntheticSourceOnly",
    "sourceAudioPersisted",
    "failureCategory"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "process-tap-tcc-denial"},
    "spikeID": {"const": "SPIKE-CAP-001"},
    "runID": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f-]{36}$"
    },
    "generatedAt": {"type": "string", "minLength": 1},
    "osVersion": {"type": "string", "minLength": 1},
    "hardwareArchitecture": {"const": "arm64"},
    "probeBundleIdentifier": {
      "const": "com.bestasr.spike.process-tap-tcc-denial-probe.v2"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "conditional"]
    },
    "denialObserved": {"type": "boolean"},
    "operatorConfirmedDenial": {"type": "boolean"},
    "tapCreated": {"type": "boolean"},
    "createTapStatus": {"type": "number"},
    "captureStarted": {"type": "boolean"},
    "startCaptureStatus": {"type": "number"},
    "callbackCount": {"type": "number", "minimum": 0},
    "frameCount": {"type": "number", "minimum": 0},
    "capturedRMS": {"type": "number", "minimum": 0},
    "capturedWatermarkAmplitude": {"type": "number", "minimum": 0},
    "watermarkDetected": {"type": "boolean"},
    "audioContentSuppressed": {"type": "boolean"},
    "tapCountBefore": {"type": "number", "minimum": 0},
    "tapCountAfter": {"type": "number", "minimum": 0},
    "aggregateDeviceCountBefore": {"type": "number", "minimum": 0},
    "aggregateDeviceCountAfter": {"type": "number", "minimum": 0},
    "syntheticSourceOnly": {"type": "boolean"},
    "sourceAudioPersisted": {"type": "boolean"},
    "failureCategory": {"type": "string", "minLength": 1}
  }
}
