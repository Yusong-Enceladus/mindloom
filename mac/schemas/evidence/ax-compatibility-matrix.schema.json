{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestasr.local/schemas/evidence/ax-compatibility-matrix.schema.json",
  "title": "bestASR external Accessibility compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "spikeID",
    "runID",
    "generatedAt",
    "osVersion",
    "hardwareArchitecture",
    "conclusion",
    "requiredTargetClasses",
    "externalApplicationMatrixEvaluated",
    "persistedTargetText",
    "persistedWindowTitle",
    "persistedClipboardContent",
    "targets",
    "unmetCriteria"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ax-compatibility-matrix"},
    "spikeID": {"const": "SPIKE-INS-001"},
    "runID": {"type": "string", "pattern": "^[0-9A-Fa-f-]{36}$"},
    "generatedAt": {"type": "string", "minLength": 1},
    "osVersion": {"type": "string", "minLength": 1},
    "hardwareArchitecture": {"const": "arm64"},
    "conclusion": {
      "type": "string",
      "enum": ["pass", "fail", "conditional"]
    },
    "requiredTargetClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "apple-editor",
          "browser",
          "chat",
          "electron",
          "office",
          "rich-text",
          "terminal"
        ]
      }
    },
    "externalApplicationMatrixEvaluated": {"type": "boolean"},
    "persistedTargetText": {"const": false},
    "persistedWindowTitle": {"const": false},
    "persistedClipboardContent": {"const": false},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetID",
          "targetClasses",
          "bundleID",
          "applicationVersion",
          "accessibilityRole",
          "status",
          "standardTrialCount",
          "forcedFallbackTrialCount",
          "successfulTrialCount",
          "successRate",
          "accessibilitySelectionCount",
          "clipboardFallbackCount",
          "clipboardRestoreFailureCount",
          "elementRefreshCount",
          "wrongTargetWriteCount",
          "unexpectedSideEffectCount",
          "p50Milliseconds",
          "p95Milliseconds",
          "cleanupSucceeded",
          "failureCategories"
        ],
        "properties": {
          "targetID": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "targetClasses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "apple-editor",
                "browser",
                "chat",
                "electron",
                "office",
                "rich-text",
                "terminal"
              ]
            }
          },
          "bundleID": {"type": "string", "minLength": 1},
          "applicationVersion": {"type": "string", "minLength": 1},
          "accessibilityRole": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "standardTrialCount": {"type": "number", "minimum": 1},
          "forcedFallbackTrialCount": {"type": "number", "minimum": 1},
          "successfulTrialCount": {"type": "number", "minimum": 0},
          "successRate": {"type": "number", "minimum": 0, "maximum": 1},
          "accessibilitySelectionCount": {"type": "number", "minimum": 0},
          "clipboardFallbackCount": {"type": "number", "minimum": 0},
          "clipboardRestoreFailureCount": {"type": "number", "minimum": 0},
          "elementRefreshCount": {"type": "number", "minimum": 0},
          "wrongTargetWriteCount": {"type": "number", "minimum": 0},
          "unexpectedSideEffectCount": {"type": "number", "minimum": 0},
          "p50Milliseconds": {"type": "number", "minimum": 0},
          "p95Milliseconds": {"type": "number", "minimum": 0},
          "cleanupSucceeded": {"type": "boolean"},
          "failureCategories": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "unmetCriteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
