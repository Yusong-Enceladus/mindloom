{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestasr.local/schemas/evidence/ax-live-insertion.schema.json",
  "title": "bestASR live Accessibility insertion probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "spikeID",
    "runID",
    "generatedAt",
    "conclusion",
    "liveAccessibilityEvaluated",
    "externalApplicationMatrixEvaluated",
    "targetClass",
    "permissionMode",
    "scenarios",
    "unmetReleaseCriteria"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ax-live-insertion-probe"},
    "spikeID": {"const": "SPIKE-INS-001"},
    "runID": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f-]{36}$"
    },
    "generatedAt": {"type": "string", "minLength": 1},
    "conclusion": {
      "type": "string",
      "enum": ["pass", "fail", "conditional"]
    },
    "liveAccessibilityEvaluated": {"type": "boolean"},
    "externalApplicationMatrixEvaluated": {"type": "boolean"},
    "targetClass": {"type": "string", "minLength": 1},
    "permissionMode": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioID",
          "status",
          "insertionMethod",
          "observedFailureCategory",
          "wrongTargetWriteCount",
          "durationMilliseconds"
        ],
        "properties": {
          "scenarioID": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "insertionMethod": {
            "type": "string",
            "enum": ["accessibility-selection", "clipboard-paste", "none"]
          },
          "observedFailureCategory": {"type": "string", "minLength": 1},
          "wrongTargetWriteCount": {"type": "number", "minimum": 0},
          "durationMilliseconds": {"type": "number", "minimum": 0}
        }
      }
    },
    "unmetReleaseCriteria": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
