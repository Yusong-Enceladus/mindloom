{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestasr.local/schemas/evidence/corpus-manifest.schema.json",
  "title": "bestASR corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "manifestID",
    "version",
    "tier",
    "releaseHoldout",
    "containsPrivateContent",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "corpus-manifest"
    },
    "manifestID": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "public",
        "product-synthetic",
        "device-lab",
        "private-consented",
        "adversarial",
        "release-holdout"
      ]
    },
    "releaseHoldout": {
      "type": "boolean"
    },
    "containsPrivateContent": {
      "type": "boolean"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleUUID",
          "consentClass",
          "assetReference",
          "contentDigest",
          "languages",
          "tags"
        ],
        "properties": {
          "sampleUUID": {
            "type": "string",
            "format": "uuid"
          },
          "consentClass": {
            "type": "string",
            "enum": [
              "public",
              "synthetic",
              "device-lab",
              "consented-private",
              "adversarial"
            ]
          },
          "assetReference": {
            "type": "string",
            "pattern": "^(fixture|local-corpus)://[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
