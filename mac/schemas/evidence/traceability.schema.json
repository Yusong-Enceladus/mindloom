{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestasr.local/schemas/evidence/traceability.schema.json",
  "title": "bestASR traceability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "manifestID",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "traceability"
    },
    "manifestID": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementIDs",
          "threatIDs",
          "scenarioIDs",
          "tests",
          "evidence"
        ],
        "properties": {
          "requirementIDs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{3}$"
            }
          },
          "threatIDs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^TM-[0-9]{2}$"
            }
          },
          "scenarioIDs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(Packages|Tests|Spikes|script)/[A-Za-z0-9._/-]+$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(artifacts/evidence/|fixture://)[A-Za-z0-9._/-]+$"
            }
          }
        }
      }
    }
  }
}
