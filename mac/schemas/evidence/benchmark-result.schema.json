{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bestasr.local/schemas/evidence/benchmark-result.schema.json",
  "title": "bestASR benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "benchmarkID",
    "runID",
    "task",
    "protocolVersion",
    "implementationRevision",
    "modelArtifact",
    "configHash",
    "corpus",
    "environmentRef",
    "hardware",
    "metrics",
    "failedSampleUUIDs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "benchmark-result"
    },
    "benchmarkID": {
      "type": "string",
      "minLength": 1
    },
    "runID": {
      "type": "string",
      "format": "uuid"
    },
    "task": {
      "type": "string",
      "enum": [
        "asr",
        "speaker",
        "llm",
        "resource"
      ]
    },
    "protocolVersion": {
      "const": 1
    },
    "implementationRevision": {
      "type": "string",
      "minLength": 1
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactID",
        "sha256"
      ],
      "properties": {
        "artifactID": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "configHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestID",
        "version",
        "split"
      ],
      "properties": {
        "manifestID": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "enum": [
            "smoke",
            "tuning",
            "release-holdout"
          ]
        }
      }
    },
    "environmentRef": {
      "type": "string",
      "pattern": "^(artifacts/evidence/|fixture://)[A-Za-z0-9._/-]+$"
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "osVersion",
        "architecture",
        "unifiedMemoryBytes",
        "toolchainVersion"
      ],
      "properties": {
        "osVersion": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "unifiedMemoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "toolchainVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "direction"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "lower-is-better",
              "higher-is-better",
              "informational"
            ]
          }
        }
      }
    },
    "failedSampleUUIDs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
