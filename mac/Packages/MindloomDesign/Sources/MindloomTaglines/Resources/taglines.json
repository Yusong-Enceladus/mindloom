{
  "version": 1,
  "zh": [
    {
      "id": "zh-01",
      "text": "记事者必提其要，纂言者必钩其玄。",
      "source": "韩愈《进学解》",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/進學解"
    },
    {
      "id": "zh-02",
      "text": "左史记言，右史记事。",
      "source": "《汉书·艺文志》",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/漢書/卷030"
    },
    {
      "id": "zh-03",
      "text": "若网在纲，有条而不紊。",
      "source": "《尚书·盘庚上》",
      "kind": "classic",
      "counterpart": "en-06",
      "checked": "https://zh.wikisource.org/wiki/尚書/盤庚上"
    },
    {
      "id": "zh-04",
      "text": "经正而后纬成，理定而后辞畅。",
      "source": "刘勰《文心雕龙·情采》",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/文心雕龍/情采"
    },
    {
      "id": "zh-05",
      "text": "物有本末，事有终始，知所先后。",
      "source": "《礼记·大学》",
      "kind": "classic",
      "counterpart": "en-04",
      "checked": "https://zh.wikisource.org/wiki/禮記/大學"
    },
    {
      "id": "zh-06",
      "text": "述往事，思来者。",
      "source": "司马迁《史记·太史公自序》",
      "kind": "classic",
      "counterpart": "en-02",
      "checked": "https://zh.wikisource.org/wiki/史記/卷130"
    },
    {
      "id": "zh-07",
      "text": "善删者字去而意留。",
      "source": "刘勰《文心雕龙·镕裁》",
      "kind": "classic",
      "counterpart": "en-03",
      "checked": "https://zh.wikisource.org/wiki/文心雕龍/鎔裁"
    },
    {
      "id": "zh-08",
      "text": "我手写我口，古岂能拘牵。",
      "source": "黄遵宪《杂感》",
      "kind": "classic",
      "counterpart": "en-07",
      "checked": "https://zh.wikisource.org/wiki/人境廬詩草/卷01"
    },
    {
      "id": "zh-09",
      "text": "唧唧复唧唧，木兰当户织。",
      "source": "《木兰诗》",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/木蘭詩"
    },
    {
      "id": "zh-10",
      "text": "贪多务得，细大不捐。",
      "source": "韩愈《进学解》",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/進學解"
    },
    {
      "id": "zh-11",
      "text": "众里寻他千百度；蓦然回首，那人却在，灯火阑珊处。",
      "source": "辛弃疾《青玉案·元夕》",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/青玉案_(辛棄疾)"
    },
    {
      "id": "zh-13",
      "text": "究天人之际，通古今之变，成一家之言。",
      "source": "司马迁《报任安书》",
      "kind": "classic",
      "counterpart": "en-09",
      "checked": "https://zh.wikisource.org/wiki/報任少卿書"
    },
    {
      "id": "zh-14",
      "text": "大胆地说话，勇敢地进行",
      "source": "鲁迅《无声的中国》",
      "kind": "modern-pd",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/無聲的中國"
    },
    {
      "id": "zh-16",
      "text": "编织你的史诗。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-15",
      "moment": "first",
      "inspiration": "用户提出的方向"
    },
    {
      "id": "zh-17",
      "text": "你只管开口，其余交给 Mindloom。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-16",
      "inspiration": "柯达 1888 年的广告语 “You press the button, we do the rest.”（只借句式）"
    },
    {
      "id": "zh-18",
      "text": "史诗，是平常日子攒出来的。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-17"
    },
    {
      "id": "zh-19",
      "text": "好记性，不如张嘴说。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-18",
      "inspiration": "俗语“好记性不如烂笔头”（改写）"
    },
    {
      "id": "zh-20",
      "text": "嗯、啊、那个，统统不算。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-19"
    },
    {
      "id": "zh-21",
      "text": "自言自语，终于有了正当理由。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-20"
    },
    {
      "id": "zh-22",
      "text": "所有的“回头再说”，都在这里。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-21"
    },
    {
      "id": "zh-23",
      "text": "一个人的会，也有纪要。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-22"
    },
    {
      "id": "zh-24",
      "text": "话里有事。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-23"
    },
    {
      "id": "zh-25",
      "text": "好久不见，上次聊到哪了？",
      "source": null,
      "kind": "plain",
      "counterpart": "en-24",
      "moment": "return"
    },
    {
      "id": "zh-27",
      "text": "说着说着，就清楚了。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-26"
    },
    {
      "id": "zh-28",
      "text": "夜深了，想法还醒着。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-27",
      "moment": "late-night"
    },
    {
      "id": "zh-29",
      "text": "东一句，西一句，也能织成一匹布。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-28"
    },
    {
      "id": "zh-30",
      "text": "千头万绪，总有头绪。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-29"
    },
    {
      "id": "zh-31",
      "text": "任务日志已更新。",
      "source": null,
      "kind": "game-idiom",
      "counterpart": "en-30",
      "inspiration": "RPG 通用界面提示，不属于哪一款游戏"
    },
    {
      "id": "zh-32",
      "text": "成就解锁：想说的，说出口了。",
      "source": null,
      "kind": "game-idiom",
      "counterpart": "en-31",
      "inspiration": "游戏平台成就弹窗的通用格式"
    },
    {
      "id": "zh-33",
      "text": "新同伴加入了队伍。",
      "source": null,
      "kind": "game-idiom",
      "counterpart": "en-32",
      "inspiration": "JRPG 入队提示的通用格式"
    },
    {
      "id": "zh-34",
      "text": "每个主角身边，都该有个执笔的人。",
      "source": null,
      "kind": "homage",
      "counterpart": "en-33",
      "inspiration": "《巫师 3》的任务日志由吟游诗人执笔；西幻里为英雄作传的诗人"
    },
    {
      "id": "zh-35",
      "text": "不久以前，在一间不太远的会议室里……",
      "source": null,
      "kind": "homage",
      "counterpart": "en-34",
      "inspiration": "《星球大战》片头字幕（反写）"
    },
    {
      "id": "zh-36",
      "text": "你的记忆宫殿，这回有了目录。",
      "source": null,
      "kind": "homage",
      "counterpart": "en-35",
      "inspiration": "《神探夏洛克》的“思维宫殿”；源头是古希腊的记忆宫殿术（公有领域）"
    },
    {
      "id": "zh-37",
      "text": "每说一句，都是一个存档点。",
      "source": null,
      "kind": "homage",
      "counterpart": "en-36",
      "inspiration": "《传说之下》（Undertale）的存档点"
    },
    {
      "id": "zh-38",
      "text": "嘿，这回换我来听。",
      "source": null,
      "kind": "homage",
      "counterpart": "en-37",
      "inspiration": "《塞尔达传说：时之笛》里 Navi 的口头禅（反写，不用原句）"
    },
    {
      "id": "zh-39",
      "text": "你醒了。今天从哪儿说起？",
      "source": null,
      "kind": "homage",
      "counterpart": "en-38",
      "moment": "morning",
      "inspiration": "《上古卷轴 V：天际》开场马车上被叫醒的场景（只借场景）"
    },
    {
      "id": "zh-40",
      "text": "来火边坐坐，说说今天。",
      "source": null,
      "kind": "homage",
      "counterpart": "en-39",
      "moment": "evening",
      "inspiration": "《黑暗之魂》的篝火"
    },
    {
      "id": "zh-41",
      "text": "一个名字，连着一串事。",
      "source": null,
      "kind": "plain",
      "counterpart": "en-40"
    },
    {
      "id": "zh-42",
      "text": "记忆会改口，原话不会。",
      "source": null,
      "kind": "homage",
      "counterpart": "en-41",
      "inspiration": "特德·姜《事实真相，感觉真相》"
    },
    {
      "id": "zh-43",
      "text": "嘤其鸣矣，求其友声。",
      "source": "《诗经·小雅·伐木》",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/詩經/伐木"
    },
    {
      "id": "zh-44",
      "text": "带露折花，色香自然要好得多",
      "source": "鲁迅《朝花夕拾·小引》",
      "kind": "modern-pd",
      "counterpart": null,
      "checked": "https://zh.wikisource.org/wiki/朝花夕拾/小引"
    },
    {
      "id": "zh-45",
      "text": "上回书说到……",
      "source": null,
      "kind": "plain",
      "counterpart": "en-43",
      "moment": "return",
      "inspiration": "评书和章回小说接着讲的开场套话"
    }
  ],
  "en": [
    {
      "id": "en-01",
      "text": "The web of our life is of a mingled yarn, good and ill together.",
      "source": "William Shakespeare, All’s Well That Ends Well",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://www.gutenberg.org/cache/epub/100/pg100.txt"
    },
    {
      "id": "en-02",
      "text": "What’s past is prologue.",
      "source": "William Shakespeare, The Tempest",
      "kind": "classic",
      "counterpart": "zh-06",
      "checked": "https://www.gutenberg.org/cache/epub/100/pg100.txt"
    },
    {
      "id": "en-03",
      "text": "Take care of the sense, and the sounds will take care of themselves.",
      "source": "Lewis Carroll, Alice’s Adventures in Wonderland",
      "kind": "classic",
      "counterpart": "zh-07",
      "checked": "https://www.gutenberg.org/cache/epub/11/pg11.txt"
    },
    {
      "id": "en-04",
      "text": "Begin at the beginning, … and go on till you come to the end: then stop.",
      "source": "Lewis Carroll, Alice’s Adventures in Wonderland",
      "kind": "classic",
      "counterpart": "zh-05",
      "checked": "https://www.gutenberg.org/cache/epub/11/pg11.txt"
    },
    {
      "id": "en-05",
      "text": "It’s a poor sort of memory that only works backwards.",
      "source": "Lewis Carroll, Through the Looking-Glass",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://www.gutenberg.org/cache/epub/12/pg12.txt"
    },
    {
      "id": "en-06",
      "text": "Let all your things have their places.",
      "source": "Benjamin Franklin, Autobiography",
      "kind": "classic",
      "counterpart": "zh-03",
      "checked": "https://www.gutenberg.org/cache/epub/20203/pg20203.txt"
    },
    {
      "id": "en-07",
      "text": "The pen is the tongue of the mind.",
      "source": "Miguel de Cervantes, Don Quixote (tr. John Ormsby)",
      "kind": "classic",
      "counterpart": "zh-08",
      "checked": "https://www.gutenberg.org/cache/epub/996/pg996.txt"
    },
    {
      "id": "en-09",
      "text": "There is properly no history, only biography.",
      "source": "Ralph Waldo Emerson, “History”",
      "kind": "classic",
      "counterpart": "zh-13",
      "checked": "https://www.gutenberg.org/cache/epub/2944/pg2944.txt"
    },
    {
      "id": "en-10",
      "text": "I am a part of all that I have met",
      "source": "Alfred Tennyson, “Ulysses”",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://www.gutenberg.org/cache/epub/8601/pg8601.txt"
    },
    {
      "id": "en-11",
      "text": "Every limit is a beginning as well as an ending.",
      "source": "George Eliot, Middlemarch",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://www.gutenberg.org/cache/epub/145/pg145.txt"
    },
    {
      "id": "en-12",
      "text": "Memory, my dear Cecily, is the diary that we all carry about with us.",
      "source": "Oscar Wilde, The Importance of Being Earnest",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://www.gutenberg.org/cache/epub/844/pg844.txt"
    },
    {
      "id": "en-13",
      "text": "Stay a little, that we may make an end the sooner.",
      "source": "quoted by Francis Bacon, “Of Dispatch”",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://www.gutenberg.org/cache/epub/575/pg575.txt"
    },
    {
      "id": "en-14",
      "text": "And so to bed.",
      "source": "Samuel Pepys, Diary",
      "kind": "classic",
      "counterpart": null,
      "moment": "late-night",
      "checked": "https://www.gutenberg.org/cache/epub/4200/pg4200.txt"
    },
    {
      "id": "en-15",
      "text": "Weave your epic.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-16",
      "moment": "first",
      "inspiration": "用户提出的方向"
    },
    {
      "id": "en-16",
      "text": "You talk. Mindloom weaves the rest.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-17",
      "inspiration": "Kodak’s 1888 slogan “You press the button, we do the rest.” (shape only)"
    },
    {
      "id": "en-17",
      "text": "Every epic is written one Tuesday at a time.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-18"
    },
    {
      "id": "en-18",
      "text": "Forget the pen. Just say it.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-19"
    },
    {
      "id": "en-19",
      "text": "Ums and uhs not included.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-20"
    },
    {
      "id": "en-20",
      "text": "Finally, a good reason to talk to yourself.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-21"
    },
    {
      "id": "en-21",
      "text": "Every “let’s circle back” ends up here.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-22"
    },
    {
      "id": "en-22",
      "text": "Minutes for a meeting of one.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-23"
    },
    {
      "id": "en-23",
      "text": "Words in. Plans out.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-24"
    },
    {
      "id": "en-24",
      "text": "Long time no see. Where were we?",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-25",
      "moment": "return"
    },
    {
      "id": "en-26",
      "text": "Ramble freely. The point will surface.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-27"
    },
    {
      "id": "en-27",
      "text": "It’s late, and your thoughts are wide awake.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-28",
      "moment": "late-night"
    },
    {
      "id": "en-28",
      "text": "Loose ends, woven in.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-29"
    },
    {
      "id": "en-29",
      "text": "So many threads. One clear pattern.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-30"
    },
    {
      "id": "en-30",
      "text": "Quest log updated.",
      "source": null,
      "kind": "game-idiom",
      "counterpart": "zh-31",
      "inspiration": "RPG 通用界面提示"
    },
    {
      "id": "en-31",
      "text": "Achievement unlocked: You said the thing.",
      "source": null,
      "kind": "game-idiom",
      "counterpart": "zh-32",
      "inspiration": "游戏平台成就弹窗的通用格式"
    },
    {
      "id": "en-32",
      "text": "A new companion has joined your party.",
      "source": null,
      "kind": "game-idiom",
      "counterpart": "zh-33",
      "inspiration": "JRPG 入队提示的通用格式"
    },
    {
      "id": "en-33",
      "text": "Every hero needs a chronicler.",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-34",
      "inspiration": "The Witcher 3 journal written by the bard Dandelion"
    },
    {
      "id": "en-34",
      "text": "Not long ago, in a meeting room not so far away…",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-35",
      "inspiration": "Star Wars opening crawl (parody, original wording)"
    },
    {
      "id": "en-35",
      "text": "Your mind palace, now with an index.",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-36",
      "inspiration": "Sherlock (BBC) mind palace; the classical method of loci"
    },
    {
      "id": "en-36",
      "text": "Every sentence is a save point.",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-37",
      "inspiration": "Undertale save points"
    },
    {
      "id": "en-37",
      "text": "Hey—this time, I’ll listen.",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-38",
      "inspiration": "Navi, The Legend of Zelda: Ocarina of Time (inverted, not the original line)"
    },
    {
      "id": "en-38",
      "text": "You’re awake. Where shall we begin?",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-39",
      "moment": "morning",
      "inspiration": "Skyrim opening scene (setting only)"
    },
    {
      "id": "en-39",
      "text": "Sit by the fire. Tell me about today.",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-40",
      "moment": "evening",
      "inspiration": "Dark Souls bonfires"
    },
    {
      "id": "en-40",
      "text": "One name, and it all comes back.",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-41"
    },
    {
      "id": "en-41",
      "text": "Memory paraphrases. Recordings quote.",
      "source": null,
      "kind": "homage",
      "counterpart": "zh-42",
      "inspiration": "Ted Chiang, The Truth of Fact, the Truth of Feeling"
    },
    {
      "id": "en-42",
      "text": "The true art of memory is the art of attention.",
      "source": "Samuel Johnson, The Idler, No. 74",
      "kind": "classic",
      "counterpart": null,
      "checked": "https://www.gutenberg.org/cache/epub/12050/pg12050.txt"
    },
    {
      "id": "en-43",
      "text": "Previously on your epic…",
      "source": null,
      "kind": "plain",
      "counterpart": "zh-45",
      "moment": "return",
      "inspiration": "The TV recap opener “Previously on…”"
    }
  ]
}
