{
  "manifest_version": 3,
  "name": "添加到 Mindloom",
  "short_name": "Mindloom",
  "version": "0.8.0",
  "description": "将所选文字或网页链接添加到这台 Mac 上的 Mindloom。点按菜单项或工具栏按钮时，读取当前网页中所选的文字，并交给这台 Mac 上的 Mindloom。",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "scripting"],
  "action": {
    "default_title": "添加到 Mindloom",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
