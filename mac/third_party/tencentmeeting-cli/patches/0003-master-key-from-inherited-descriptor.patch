+// MasterKeyFDEnv names a file descriptor, inherited from the program that
+// started tmeet, that holds the master key (Mindloom build, patch 0003).
+// Mindloom keeps the key in its own Keychain item, which other programs
+// cannot read without the owner's approval, and hands it over on this
+// descriptor on every run: base64 text or the 32 raw bytes, read to the end
+// and closed. While it is set the system Keychain is never read or written,
+// and a missing, unreadable or malformed key is an error: there is no
+// fallback to the system Keychain. Without it tmeet behaves as upstream.
+const MasterKeyFDEnv = "TMEET_MASTER_KEY_FD"
+
+// maxMasterKeyInput bounds what is read from the descriptor.
+const maxMasterKeyInput = 256
+
+// keyringGet and keyringSet are the system Keychain calls (replaced in tests
+// to prove the descriptor mode never reaches them).
+var (
+	keyringGet = keyring.Get
+	keyringSet = keyring.Set
+)
+
 // darwinKeychain is the macOS platform implementation.
 // The master key is cached in memory via sync.Once to avoid accessing the system Keychain on every operation (IPC ~1-5ms).
 type darwinKeychain struct {
@@ -45,7 +68,10 @@ func (k *darwinKeychain) getMasterKey() ([]byte, error) {
 
 // loadOrCreateMasterKey loads the master key from the system Keychain; auto-generates and stores it if not found.
