+	encoded, err := keyringGet(ServiceName, MasterKeyAccount)
 	if err == nil {
 		masterKey, decErr := base64.StdEncoding.DecodeString(encoded)
 		if decErr != nil {
@@ -67,7 +93,7 @@ func (k *darwinKeychain) loadOrCreateMasterKey() ([]byte, error) {
 	}
 
 	encoded = base64.StdEncoding.EncodeToString(masterKey)
-	if err = keyring.Set(ServiceName, MasterKeyAccount, encoded); err != nil {
+	if err = keyringSet(ServiceName, MasterKeyAccount, encoded); err != nil {
 		return nil, fmt.Errorf("failed to write system Keychain: %w", err)
 	}
 
@@ -129,3 +155,41 @@ func (k *darwinKeychain) Remove(service, account string) error {
