Mindloom patch 0001: never send crash reports.

Upstream sends the stack and the account's openId to Tencent (/v1/cli/crash) when tmeet panics.
The crash is still written to the local log and printed to standard error.
Regression test: internal/crash/reporter_local_test.go (a test server receives nothing).

diff --git a/internal/crash/reporter.go b/internal/crash/reporter.go
index 91ddad6..7180a5d 100644
--- a/internal/crash/reporter.go
+++ b/internal/crash/reporter.go
@@ -21,6 +21,9 @@ import (
 // crashReportURI is the server endpoint to receive CLI crash reports.
 const crashReportURI = "/v1/cli/crash"
 
+// crashReportingDisabled is true in the Mindloom build (see patches/).
+const crashReportingDisabled = true
+
 // reportTimeout limits the total time spent on a single crash report so
 // that a slow network does not delay the CLI exit noticeably.
 const reportTimeout = 1 * time.Second
@@ -37,6 +40,13 @@ func Report(ctx context.Context, tmeet *internal.Tmeet, errorCode int, crashStac
 	// Defence-in-depth: never let the reporter itself take the CLI down.
 	defer func() { _ = recover() }()
 
+	// Mindloom build: remote crash reporting is off. The crash is still
+	// written to the local log and printed to stderr by RecoverAndReport.
+	if crashReportingDisabled {
+		log.Warnf(ctx, "crash report not sent (disabled in this build), error_code=%d", errorCode)
+		return
+	}
+
 	if tmeet == nil {
 		return
 	}
diff --git a/internal/crash/reporter_local_test.go b/internal/crash/reporter_local_test.go
new file mode 100644
index 0000000..9a2bb4d
--- /dev/null
+++ b/internal/crash/reporter_local_test.go
@@ -0,0 +1,53 @@
+package crash
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"tmeet/internal"
+	"tmeet/internal/common"
+	"tmeet/internal/config"
+	"tmeet/internal/core/serializable"
+	"tmeet/internal/core/thttp"
+)
+
+// Mindloom build (patch 0001): a crash is logged on this Mac and never sent.
+func TestReportSendsNothing(t *testing.T) {
+	var hits atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hits.Add(1)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{}`))
+	}))
+	defer srv.Close()
+	t.Setenv("TMEET_CLI_CONFIG_DIR", t.TempDir())
+	t.Setenv("TMEET_CLI_DATA_DIR", t.TempDir())
+	config.ResetCache()
+	clt, err := thttp.NewClient(strings.TrimPrefix(srv.URL, "http://"),
+		thttp.WithProtocol("http"),
+		thttp.WithSerializer(serializable.DefaultSerializer),
+		thttp.WithClient(&http.Client{Timeout: 3 * time.Second}))
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().Unix()
+	tm := &internal.Tmeet{
+		TCtx:       context.Background(),
+		CGIClient:  clt,
+		RestClient: clt,
+		SystemInfo: &common.SystemInfo{MachineID: "test-machine"},
+		UserConfig: &config.UserConfig{
+			SdkId: "sdk", OpenId: "open_test", AccessToken: "a", RefreshToken: "r",
+			Expires: now + 3600, RefreshTokenExpires: now + 7200,
+		},
+	}
+	Report(context.Background(), tm, 9000, "synthetic stack")
+	if n := hits.Load(); n != 0 {
+		t.Fatalf("crash report sent %d request(s); want none", n)
+	}
+}
