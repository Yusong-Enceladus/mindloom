<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(MINDLOOM_PHONE_BUNDLE_ID).outbox-refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>Mindloom</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(MINDLOOM_PHONE_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mindloom</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MindloomAppBundleID</key>
	<string>$(MINDLOOM_PHONE_BUNDLE_ID)</string>
	<key>MindloomAppGroup</key>
	<string>$(MINDLOOM_APP_GROUP)</string>
	<key>MindloomPrivateKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(MINDLOOM_PHONE_BUNDLE_ID)</string>
	<key>MindloomShareKeyKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(MINDLOOM_PHONE_BUNDLE_ID).sharekey</string>
	<key>MindloomSharedKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(MINDLOOM_PHONE_BUNDLE_ID).shared</string>
	<key>NSCameraUsageDescription</key>
	<string>Mindloom 使用相机扫描 Mac 上显示的二维码。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mindloom 通过本地网络将你发送的内容传送到你的 Mac。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Mindloom 使用麦克风录制你按住说话时的内容，并在这台 iPhone 上转写为文字。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Mindloom 使用 iPhone 自带的语音识别，在这台 iPhone 上将口述转写为文字。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Paper</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
