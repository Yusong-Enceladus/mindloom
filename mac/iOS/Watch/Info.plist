	<string>Mindloom 使用麦克风录制你开始的录音。录音发送到你的 iPhone，在 iPhone 上转写为文字。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(MINDLOOM_PHONE_BUNDLE_ID)</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<false/>
</dict>
</plist>
