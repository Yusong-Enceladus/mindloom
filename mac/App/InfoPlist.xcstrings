    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "织机 records audio only from the app or Mac output you choose for a recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织机只录你为这次记录选定的 App 或整台 Mac 的声音。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "织机 uses the microphone only for recordings you start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织机只在你开始记录时使用麦克风。"
          }
        }
      }
    }
