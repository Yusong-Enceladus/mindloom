{
 "type": "object",
 "properties": {
  "strands": {
   "type": "array",
   "minItems": 1,
   "maxItems": 6,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "s1",
       "s2",
       "s3",
       "s4",
       "s5",
       "s6"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
     },
     "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
     },
     "item_ids": {
      "type": "array",
      "maxItems": 400,
      "items": {
       "type": "string",
       "pattern": "^I[0-9]+$"
      }
     },
     "fact_ids": {
      "type": "array",
      "maxItems": 12,
      "items": {
       "type": "string",
       "pattern": "^f[0-9]+$"
      }
     },
     "state": {
      "type": "string",
      "enum": [
       "open",
       "closed"
      ]
     }
    },
    "required": [
     "id",
     "name",
     "summary",
     "item_ids",
     "fact_ids",
     "state"
    ],
    "additionalProperties": false
   }
  },
  "knots": {
   "type": "array",
   "maxItems": 20,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^k[0-9]+$"
     },
     "strand": {
      "type": "string",
      "pattern": "^(s[1-6])?$"
     },
     "kind": {
      "type": "string",
      "enum": [
       "progress",
       "decision",
       "question",
       "commitment",
       "deadline"
      ]
     },
     "text": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
     },
     "date": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"
     },
     "state": {
      "type": "string",
      "enum": [
       "done",
       "doing",
       "planned",
       "open"
      ]
     },
     "who": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 24
      }
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
       "type": "string",
       "pattern": "^I[0-9]+$"
      }
     },
     "quote": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
     }
    },
    "required": [
     "id",
     "strand",
     "kind",
     "text",
     "date",
     "state",
     "who",
     "evidence",
     "quote"
    ],
    "additionalProperties": false
   }
  },
  "health": {
   "type": "object",
   "properties": {
    "level": {
     "type": "string",
     "enum": [
      "ok",
      "risk",
      "stuck"
     ]
    },
    "reason": {
     "type": "string",
     "minLength": 2,
     "maxLength": 40
    },
    "evidence": {
     "type": "array",
     "maxItems": 3,
     "items": {
      "type": "string",
      "pattern": "^I[0-9]+$"
     }
    }
   },
   "required": [
    "level",
    "reason",
    "evidence"
   ],
   "additionalProperties": false
  },
  "blocks": {
   "type": "array",
   "maxItems": 4,
   "items": {
    "type": "object",
    "properties": {
     "other": {
      "type": "string",
      "pattern": "^E[0-9]+$"
     },
     "direction": {
      "type": "string",
      "enum": [
       "waits_on",
       "blocks"
      ]
     },
     "item_id": {
      "type": "string",
      "pattern": "^I[0-9]+$"
     },
     "quote": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60
     }
    },
    "required": [
     "other",
     "direction",
     "item_id",
     "quote"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "strands",
  "knots",
  "health",
  "blocks"
 ],
 "additionalProperties": false
}