{
 "type": "object",
 "properties": {
  "title": {"type": "string", "minLength": 1, "maxLength": 20},
  "status_facts": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "type": "object",
    "properties": {
     "text": {"type": "string", "minLength": 2, "maxLength": 40},
     "state": {"type": "string", "enum": ["planned", "in_progress", "done", "cancelled", "info"]},
     "date": {"type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"},
     "quote": {"type": "string", "maxLength": 24},
     "item_ids": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "pattern": "^I[0-9]+$"}}
    },
    "required": ["text", "state", "date", "quote", "item_ids"],
    "additionalProperties": false
   }
  },
  "status_line": {"type": "string", "minLength": 4, "maxLength": 36},
  "off_anchor_item_ids": {"type": "array", "maxItems": 3, "items": {"type": "string", "pattern": "^I[0-9]+$"}}
 },
 "required": ["title", "status_facts", "status_line", "off_anchor_item_ids"],
 "additionalProperties": false
}
