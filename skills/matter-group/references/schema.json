{
 "type": "object",
 "properties": {
  "new_ropes": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "properties": {
     "key": {
      "type": "string",
      "enum": [
       "N1",
       "N2",
       "N3",
       "N4",
       "N5",
       "N6",
       "N7",
       "N8"
      ]
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12
     },
     "kind": {
      "type": "string",
      "enum": [
       "area",
       "project"
      ]
     },
     "parent": {
      "type": "string",
      "pattern": "^((R|N)[0-9]+)?$"
     },
     "reason": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
       "type": "string",
       "pattern": "^I[0-9]+$"
      }
     }
    },
    "required": [
     "key",
     "title",
     "kind",
     "parent",
     "reason",
     "evidence"
    ],
    "additionalProperties": false
   }
  },
  "nest": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "properties": {
     "rope": {
      "type": "string",
      "pattern": "^R[0-9]+$"
     },
     "parent": {
      "type": "string",
      "pattern": "^(R|N)[0-9]+$"
     }
    },
    "required": [
     "rope",
     "parent"
    ],
    "additionalProperties": false
   }
  },
  "placements": {
   "type": "array",
   "maxItems": 60,
   "items": {
    "type": "object",
    "properties": {
     "matter": {
      "type": "string",
      "pattern": "^E[0-9]+$"
     },
     "rope": {
      "type": "string",
      "pattern": "^((R|N)[0-9]+)?$"
     },
     "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6
     }
    },
    "required": [
     "matter",
     "rope",
     "type"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "new_ropes",
  "nest",
  "placements"
 ],
 "additionalProperties": false
}