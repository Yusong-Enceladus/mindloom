      "item_id": "B72DE617-EF3C-530B-8A08-DB7963CAAB3F",
      "ref": "h2-06",
      "t": "2026-08-18T20:00:00+08:00",
      "kind": "dictation",
      "source_app": "ChatGPT",
      "persons": [
        "p_owner"
      ],
      "events": [
        "ev_talk"
      ],
      "text": "帮我列一个30分钟分享的大纲，主题是怎么把设计评审开短一点。",
      "duration_ms": 6900
    },
    {
      "item_id": "C017373E-C350-5092-9023-941E99268B70",
      "ref": "h3-01",
      "t": "2026-08-19T14:00:00+08:00",
      "kind": "meeting_online",
      "source_app": "腾讯会议",
      "persons": [
        "p_owner",
        "p_feng",
        "p_shi"
      ],
      "events": [
        "ev_app"
      ],
